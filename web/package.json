{
  "name": "jevflow-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:core": "npm --prefix .. run build",
    "predev": "npm run prepare:core",
    "dev": "next dev",
    "prebuild": "npm run prepare:core",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "pretypecheck": "npm run prepare:core && npm run typegen",
    "typecheck": "tsc --noEmit",
    "prelint": "npm run prepare:core",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run prepare:core",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "28.1.0",
    "postcss": "8.5.28",
    "prettier": "3.8.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}

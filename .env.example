# Optional for offline development. Required only for an explicit live Jev request.
TYPESAFE_API_KEY=

# GitHub Actions supplies its own repository-scoped token to the guarded runner.
# Leave empty for normal local development and offline checks.
GITHUB_TOKEN=

# Confidence policy thresholds, inclusive range 0..1.
AUTO_THRESHOLD=0.90
REVIEW_THRESHOLD=0.75
